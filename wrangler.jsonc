{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybercasters",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "CyberStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CyberStore"]
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://cyber-casters.com",
    "DISABLE_DEMO": "0"
  },
  "routes": [
    { "pattern": "cyber-casters.com", "custom_domain": true },
    { "pattern": "www.cyber-casters.com", "custom_domain": true }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ]
}
